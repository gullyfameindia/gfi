# Created by Kiro - Production Environment Configuration for Admin Dashboard
# Copy this file to .env.local and fill in your actual values

# API Configuration
# Backend server URL for admin panel
NEXT_PUBLIC_API_BASE_URL=https://gullyfame.com/v1/api/

# Environment
NODE_ENV=production

# Next.js Configuration
NEXT_PUBLIC_APP_NAME=Gully Fame Admin
NEXT_PUBLIC_APP_VERSION=1.0.0

# Sentry Configuration (Error Tracking) - Optional
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Analytics Configuration - Optional
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

